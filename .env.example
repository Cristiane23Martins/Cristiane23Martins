# Copie este arquivo para ".env" e preencha os valores.

# ---------- Gemini ----------
# Chave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_sua_chave_aqui
GEMINI_MODEL=gemini-2.5-flash

# ---------- Uazapi ----------
# Endereço do seu servidor Uazapi (aparece no painel), sem barra no final
UAZAPI_URL=https://SEU-SUBDOMINIO.uazapi.com
# Token da INSTÂNCIA conectada ao número do bot (painel da Uazapi)
UAZAPI_TOKEN=cole_o_token_da_instancia
# Número do bot com DDI 55 + DDD (só números). Ex.: 5527999999999
BOT_NUMERO=

# ---------- Servidor do webhook ----------
PORTA=3000

# ---------- Atendimento ----------
NOME_EMPRESA=Loja Exemplo
# Palavra que o cliente precisa enviar para INICIAR um atendimento.
# Deixe vazio para que qualquer mensagem inicie um atendimento.
PALAVRA_INICIO=#teste
# (Opcional) Só atende estes números. Ex.: 5527988887777,5511977776666
NUMEROS_PERMITIDOS=
# Encerra o atendimento automaticamente após X minutos sem mensagem
TIMEOUT_MINUTOS=10
