# Copie este arquivo para ".env" e preencha os valores.

# Chave gratuita do Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_sua_chave_aqui
# Modelo do Gemini (o "flash" tem cota gratuita)
GEMINI_MODEL=gemini-2.5-flash

# URL do Web App do Google Apps Script (veja apps-script/Code.gs e o README).
# Se ficar vazio, o bot usa dados de exemplo e salva os logs em ./logs
SHEETS_WEBAPP_URL=

# Nome da empresa fictícia usada no atendimento
NOME_EMPRESA=Loja Exemplo

# Palavra que o cliente precisa enviar para INICIAR um atendimento.
# Isso evita que o bot responda todos os seus contatos no WhatsApp.
PALAVRA_INICIO=#teste

# (Opcional) Só atende estes números. Formato: 5511999999999, separados por vírgula.
NUMEROS_PERMITIDOS=

# Encerra o atendimento automaticamente após X minutos sem mensagem
TIMEOUT_MINUTOS=10
